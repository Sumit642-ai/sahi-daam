# Optional backend for anonymous counters, the Pro waitlist, feedback and opt-in
# benchmarks (spec v2, section 10). Leave unset and the app works the same:
# nothing is sent anywhere, and /stats says "not connected".
#
# 1. Create a Supabase project and run supabase/migrations/0001_sahi_daam.sql.
# 2. Set the stats secret inside the database (never here):
#      insert into private.settings (name, value) values ('stats_key', '<long random string>');
# 3. Copy this file to .env.local (git-ignored) or set the variables in Vercel.
#
# The anon key is public by design: row-level security only lets it INSERT.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
