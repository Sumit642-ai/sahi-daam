    "shoot": "node scripts/shoot.mjs",
    "verify:journey": "vite-node scripts/print-journey.ts",
    "gen:i18n": "node scripts/generate-i18n.mjs",
    "export:sim": "vite-node scripts/export-sim-results.ts",
    "verify:engine": "vite-node scripts/print-engine-v2.ts",
    "check:bundle": "node scripts/check-bundle.mjs",
    "check:layout": "node scripts/check-layout.mjs",
    "check:upload": "node scripts/check-upload.mjs",
    "check:pricing": "node scripts/check-pricing.mjs",
    "check:phase-d": "node scripts/check-phase-d.mjs"
  },
  "dependencies": {
    "@fontsource/noto-sans-devanagari": "^5.3.0",
    "@fontsource/poppins": "^5.3.0",
    "dexie": "^4.4.6",
    "dexie-react-hooks": "^1.1.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6",
