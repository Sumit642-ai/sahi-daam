{
  "name": "sahi-daam",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Sahi Daam — lifecycle pricing for the new-to-online Meesho seller (Team Taraazu, Meesho DICE 3.0, PS#4)",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
