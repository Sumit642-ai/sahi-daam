{
  "name": "sahi-daam",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Sahi Daam — lifecycle pricing for the new-to-online Meesho seller (Team Taraazu, Meesho DICE 3.0, PS#4)",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --noEmit",
    "gen:listings": "node scripts/generate-listings.mjs",
    "verify:deck": "vite-node scripts/print-deck-table.ts",
    "verify:screen1": "vite-node scripts/print-screen1.tsx",
    "shoot": "node scripts/shoot.mjs",
    "verify:journey": "vite-node scripts/print-journey.ts",
    "gen:i18n": "node scripts/generate-i18n.mjs",
    "export:sim": "vite-node scripts/export-sim-results.ts"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.13.3"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.6.3",
    "vite": "^6.4.3",
    "vitest": "^3.2.7"
  }
}
